rules_version = '2';

// GSUhub Firestore Security Rules — Objective 1.B.
//
// WRITTEN, NOT DEPLOYED. Deploying these is Objective 1.C's job, against a
// real Firebase project.
//
// SOURCE OF THE PERMISSION MATRIX
// -------------------------------
// The development plan these were meant to implement (§4) was never
// available. This matrix is therefore DERIVED from manuscript §3.4
// "A. Requirements Specification", which enumerates what each of the three
// roles may do, plus the scope limits in §1.5. Every rule below traces to
// one of those statements. Review against the real permission matrix
// before deploying — see docs/data_dictionary.md.
//
// SHAPE OF THE MATRIX
// -------------------
//   requestor  (faculty/staff) — mobile. Submits reports, tracks OWN
//               reports, rates completed work. Reads facilities/assets to
//               fill in a report. Sees nothing belonging to anyone else.
//   personnel  (GSU maintenance) — mobile. Reads work orders ASSIGNED to
//               them, updates their progress, files accomplishment
//               reports, borrows/returns tools, records material usage.
//   admin      (GSU Administrator) — web. Full read across the system;
//               sole authority over classification, official priority,
//               assignment, duplicate merging, user accounts, and config.
//
// TWO COLLECTIONS ARE APPEND-ONLY FOR EVERYONE, ADMINS INCLUDED:
// `inventory_transactions` and `audit_logs`. A ledger or audit trail that
// a privileged user can rewrite is not a ledger or an audit trail. Their
// rules below allow create and deny update/delete unconditionally.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // An account that has been deactivated (§1.5 "account activation or
    // deactivation") keeps its Auth credentials but loses all access.
    function isActive() {
      return isSignedIn() && userDoc().accountStatus == 'active';
    }

    function hasRole(role) {
      return isActive() && userDoc().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isPersonnel() {
      return hasRole('maintenancePersonnel');
    }

    function isRequestor() {
      return hasRole('requestor');
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when a write changes none of the listed fields.
    function leavesUntouched(fields) {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(fields);
    }

    // True when a write leaves every field except those listed untouched.
    function onlyChanged(allowedFields) {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(allowedFields);
    }

    // ---------- users ----------
    // §3.4: administrators "manage user accounts, roles, permissions".
    // Everyone may read their own record (the app needs the role to route);
    // personnel are readable by admins for assignment.

    // A faculty or staff member signing themselves up (Objective 3.A).
    // They may only ever ask: the profile is their own, under the email
    // they signed in with, as a requestor, pending an administrator's
    // approval, and carrying none of the personnel-only fields. §1.5 limits
    // GSUhub to "authorized" faculty and staff, so nothing a person writes
    // here lets them in — activation is the administrator's.
    function isSelfRegistration(uid) {
      let data = request.resource.data;
      return isSelf(uid)
        && data.keys().hasOnly([
             'fullName', 'email', 'role', 'accountStatus', 'department',
             'contactNumber', 'specialization', 'availability',
             'activeTaskCount', 'fcmToken', 'createdAt', 'updatedAt'
           ])
        && data.role == 'requestor'
        && data.accountStatus == 'pending'
        && data.email == request.auth.token.email
        && data.fullName is string
        && data.fullName.size() > 0 && data.fullName.size() <= 120
        && (data.get('department', null) == null
            || (data.department is string && data.department.size() <= 120))
        && (data.get('contactNumber', null) == null
            || (data.contactNumber is string
                && data.contactNumber.size() <= 40))
        && data.get('specialization', null) == null
        && data.get('availability', null) == null
        && data.get('activeTaskCount', 0) == 0
        && data.get('fcmToken', null) == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // Administrators provision accounts outright (2.C); anyone else may
      // only file a request for their own (3.A).
      allow create: if isAdmin() || isSelfRegistration(uid);

      // A user may maintain their own contact details and push token, but
      // never their own role or account status — that would let any account
      // promote itself to admin. That holds for administrators too, in the
      // other direction: one demoting or deactivating their own account
      // could leave the system with nobody able to manage it (2.C).
      allow update: if (isAdmin()
          && (!isSelf(uid) || leavesUntouched(['role', 'accountStatus'])))
        || (isSelf(uid) && onlyChanged([
             'fullName', 'contactNumber', 'department', 'fcmToken', 'updatedAt'
           ]));

      // Accounts are deactivated, not deleted, so historical reports keep
      // resolving their denormalized reporterName.
      allow delete: if false;
    }

    // ---------- facilities & assets ----------
    // Any active user may read these: a requestor needs them to fill in a
    // report, a technician to find the site. Only admins maintain them.

    match /facilities/{facilityId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- damage_reports ----------
    // §3.4 requestor capabilities: submit reports, view own reports and
    // history, track status. §3.4 admin capabilities: view and manage ALL
    // reports, classify, set priority, merge duplicates.

    // A report as a requestor files it (Objective 3.C): their own account
    // of the damage, well-formed, and none of the fields an administrator's
    // review sets. Absent and null count alike, so a client that leaves a
    // field out is not refused for it.
    //
    // Classification and scoring fields (category, classifiedAutomatically,
    // the four ratings, priorityScore, recommendedPriority) are left to
    // Objective 4: with no Cloud Functions on the Spark plan, the keyword
    // classifier may well run on the submitting device, and would then need
    // to write them here.
    function isRequestorSubmission(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string
        && data.description.size() > 0 && data.description.size() <= 5000
        && data.requestorPriority in ['low', 'medium', 'high', 'critical']
        // The damage type the requestor suggests — a suggestion only, kept
        // apart from `category`.
        && (data.get('requestorCategory', null) == null
            || data.requestorCategory in [
                 'electrical', 'plumbing', 'structural', 'carpentry',
                 'airConditioning', 'cleaningAndSanitation',
                 'generalMaintenance'
               ])
        && data.get('photoUrls', []) is list
        && data.get('photoUrls', []).size() <= 10
        && (data.get('coordinates', null) == null
            || data.coordinates is latlng)
        && data.get('officialPriority', null) == null
        && data.get('duplicateOf', null) == null
        && data.get('workOrderId', null) == null
        && data.get('reviewedBy', null) == null
        && data.get('reviewedAt', null) == null
        && data.get('rejectionReason', null) == null;
    }

    // A status history entry (Objective 3.B) for the report at [reportPath]:
    // the status that report has once this request commits, stamped by its
    // writer at server time, with only the fields the timeline reads.
    function isStatusChange(reportPath) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'status', 'changedAt', 'changedBy', 'note', 'personnelName',
               'personnelSpecialization'
             ])
        && data.status == getAfter(reportPath).data.status
        && data.changedBy == request.auth.uid
        && data.changedAt == request.time
        && (data.get('note', null) == null || data.note is string)
        && (data.get('personnelName', null) == null
            || data.personnelName is string)
        && (data.get('personnelSpecialization', null) == null
            || data.personnelSpecialization is string);
    }

    match /damage_reports/{reportId} {
      allow get: if isAdmin()
        // `resource == null` lets a requestor ask whether a report id is
        // taken before filing under it — the submission transaction reads
        // first so a retry after a timeout cannot file twice (3.C). A
        // missing document discloses nothing: the ids are random.
        || (isActive()
            && (resource == null
                || resource.data.reporterId == request.auth.uid))
        // Personnel can open a report they are working: it is the context
        // for their assigned work order.
        || (isPersonnel() && resource.data.workOrderId != null);

      // A requestor lists their own reports only. Until 3.C this checked
      // the page size and nothing else, so any requestor could query every
      // other requestor's reports — photos and geo-tags included.
      allow list: if isAdmin()
        || (isRequestor()
            && resource.data.reporterId == request.auth.uid
            && request.query.limit <= 100);

      // A requestor may only file a report as themselves, and may not
      // pre-set any field that is the Administrator's decision to make.
      allow create: if isRequestor()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && isRequestorSubmission(request.resource.data);

      // Classification, official priority, duplicate merging and status are
      // administrator-only (§1.2, §3.4). A requestor gets no update path at
      // all — a submitted report is a record, and corrections go through
      // GSU rather than being silently edited.
      allow update: if isAdmin()
        // Personnel may advance status on a report tied to their work,
        // nothing more.
        || (isPersonnel() && onlyChanged(['status', 'updatedAt']));

      allow delete: if false;

      // One entry per status change, for the requestor's progress
      // timeline (3.B). Requestors cannot read audit_logs, so the timeline
      // needs its own record. Append-only: a timeline that could be
      // rewritten would record nothing.
      match /status_history/{entryId} {
        function report() {
          return /databases/$(database)/documents/damage_reports/$(reportId);
        }

        // Whoever may read the report may read how it got where it is.
        allow read: if isAdmin()
          || (isActive() && get(report()).data.reporterId == request.auth.uid)
          || (isPersonnel() && get(report()).data.workOrderId != null);

        // Each entry is written in the same transaction as the move it
        // records, so it must name the status the report has once that
        // transaction commits — an entry cannot claim a move that did not
        // happen. A requestor writes only the first, while filing their
        // own report; personnel, a move on a report with a work order —
        // the same reach their report update has.
        allow create: if isStatusChange(report())
          && (isAdmin()
              || (isRequestor()
                  && request.resource.data.status == 'submitted'
                  && !exists(report())
                  && getAfter(report()).data.reporterId == request.auth.uid)
              || (isPersonnel()
                  && getAfter(report()).data.workOrderId != null));

        allow update, delete: if false;
      }
    }

    // ---------- work_orders ----------
    // §3.4 admin: assign work orders, monitor progress, update statuses.
    // §3.4 personnel: view ASSIGNED work orders, update their status.

    match /work_orders/{workOrderId} {
      allow get: if isAdmin()
        || (isPersonnel()
            && request.auth.uid in resource.data.assignedPersonnelIds);
      allow list: if isAdmin() || isPersonnel();

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (isPersonnel()
            && request.auth.uid in resource.data.assignedPersonnelIds
            && onlyChanged(['status', 'startedAt', 'completedAt', 'updatedAt']));

      allow delete: if false;
    }

    // ---------- tasks ----------

    match /tasks/{taskId} {
      allow get: if isAdmin()
        || (isPersonnel() && resource.data.assignedTo == request.auth.uid);
      allow list: if isAdmin() || isPersonnel();

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (isPersonnel()
            && resource.data.assignedTo == request.auth.uid
            && onlyChanged([
                 'status', 'proofPhotoUrls', 'completedAt', 'updatedAt'
               ]));

      allow delete: if isAdmin();
    }

    // ---------- accomplishment_reports ----------
    // §3.4 personnel: "submit completion notes and upload photo evidence".

    match /accomplishment_reports/{reportId} {
      allow get: if isAdmin()
        || (isPersonnel() && resource.data.submittedBy == request.auth.uid);
      allow list: if isAdmin() || isPersonnel();

      allow create: if isPersonnel()
        && request.resource.data.submittedBy == request.auth.uid
        // The deduction guard flag is set by the deduction routine, never
        // by the submitting client.
        && request.resource.data.inventoryDeducted == false;

      // Only the review fields are mutable after filing, and only by an
      // admin — a completion record that its author can quietly rewrite is
      // not documentation.
      allow update: if isAdmin()
        && onlyChanged(['reviewedBy', 'reviewedAt', 'inventoryDeducted']);

      allow delete: if false;
    }

    // ---------- inventory ----------

    match /inventory_items/{itemId} {
      allow read: if isActive();

      allow create, delete: if isAdmin();

      // Descriptive fields are admin-maintained. `quantityAvailable` is
      // writable by admins and personnel ONLY as part of recording a
      // transaction — the client-side repository contract is the thing that
      // pairs them. Rules alone cannot verify that a matching ledger entry
      // was written in the same batch, so 1.C should move this behind a
      // Cloud Function or a transaction-checked rule if the guarantee needs
      // to be airtight. Noted in docs/data_dictionary.md.
      allow update: if isAdmin()
        || (isPersonnel()
            && onlyChanged(['quantityAvailable', 'updatedAt']));
    }

    // APPEND-ONLY. No update, no delete, for any role.
    match /inventory_transactions/{transactionId} {
      allow read: if isAdmin() || isPersonnel();
      allow create: if (isAdmin() || isPersonnel())
        && request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- tools ----------

    match /tools/{toolId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // Borrow/return flips status, holder, loan pointer and condition.
        || (isPersonnel() && onlyChanged([
             'status', 'condition', 'currentHolderId', 'currentLoanId',
             'updatedAt'
           ]));
    }

    match /tool_loans/{loanId} {
      allow get: if isAdmin()
        || (isPersonnel() && resource.data.borrowedBy == request.auth.uid);
      allow list: if isAdmin() || isPersonnel();

      allow create: if (isAdmin() || isPersonnel())
        && request.resource.data.borrowedBy == request.auth.uid
        && request.resource.data.returnedAt == null;

      // Closing out a loan sets the return fields only. The borrow record
      // itself is history and stays put.
      allow update: if isAdmin()
        || (isPersonnel()
            && resource.data.borrowedBy == request.auth.uid
            && onlyChanged(['returnedAt', 'conditionOnReturn', 'notes']));

      allow delete: if false;
    }

    // ---------- feedback ----------
    // §3.4 requestor: "provide feedback and ratings for completed
    // maintenance services". §1.5: ratings "do not automatically determine
    // personnel performance evaluations" — hence personnel cannot read
    // them; only administrators see the evaluation data.

    match /feedback/{feedbackId} {
      allow get: if isAdmin()
        || (isRequestor() && resource.data.submittedBy == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isRequestor()
        && request.resource.data.submittedBy == request.auth.uid;

      // Feedback is a point-in-time evaluation; editing it after the fact
      // would misrepresent the record.
      allow update, delete: if false;
    }

    // ---------- notifications ----------

    // A notification as the app writes it (Objective 3.B): well-formed,
    // unread, stamped at server time.
    function isNewNotification() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'recipientId', 'type', 'title', 'body', 'relatedEntityType',
               'relatedEntityId', 'isRead', 'readAt', 'createdAt'
             ])
        && data.recipientId is string
        && data.type in [
             'reportAcknowledged', 'workOrderAssigned', 'taskAssigned',
             'statusUpdate', 'maintenanceCompleted', 'lowStockAlert'
           ]
        && data.title is string
        && data.title.size() > 0 && data.title.size() <= 120
        && data.body is string && data.body.size() <= 1000
        && data.isRead == false
        && data.get('readAt', null) == null
        && data.createdAt == request.time;
    }

    // A notification about a damage report, addressed to the person who
    // filed it — checked against the report as it stands once the write
    // commits, which is how it stands in the transaction that moved it.
    function isToReporter() {
      let data = request.resource.data;
      return data.get('relatedEntityType', null) == 'damage_reports'
        && data.relatedEntityId is string
        && getAfter(/databases/$(database)/documents/damage_reports/$(data.relatedEntityId))
             .data.reporterId == data.recipientId;
    }

    match /notifications/{notificationId} {
      allow get, list: if isActive()
        && resource.data.recipientId == request.auth.uid;

      // 1.B left this to Cloud Functions; the project is on the Spark plan,
      // which has none (3.B). So the client that moves a report writes the
      // notice in the same transaction, and these rules keep each one to
      // the report's own reporter:
      // - an administrator, for any report's reporter;
      // - a requestor, only their own "received" notice, while filing that
      //   very report — never one for anybody else;
      // - personnel, a move on a report with a work order (Objective 5) —
      //   the same reach their report update has.
      allow create: if isNewNotification()
        && (isAdmin() && (
              request.resource.data.get('relatedEntityType', null)
                != 'damage_reports'
              || isToReporter())
          || (isRequestor()
              && request.resource.data.recipientId == request.auth.uid
              && request.resource.data.type == 'reportAcknowledged'
              && isToReporter()
              && !exists(/databases/$(database)/documents/damage_reports/$(request.resource.data.relatedEntityId)))
          || (isPersonnel()
              && isToReporter()
              && getAfter(/databases/$(database)/documents/damage_reports/$(request.resource.data.relatedEntityId))
                   .data.workOrderId != null));

      // A recipient may only mark their own notification read: nothing
      // else about it changes, and it is not marked unread again.
      allow update: if isActive()
        && resource.data.recipientId == request.auth.uid
        && onlyChanged(['isRead', 'readAt'])
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time;

      allow delete: if isActive()
        && resource.data.recipientId == request.auth.uid;
    }

    // ---------- audit_logs ----------
    // APPEND-ONLY, admins included. §3.4 Auditability.

    match /audit_logs/{entryId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- config ----------
    // Readable by any active user (the apps need the keyword dictionary and
    // thresholds); writable only by administrators.

    match /config/{documentId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- default deny ----------
    // Anything not matched above is denied. Adding a collection means
    // adding a rule for it, deliberately.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
