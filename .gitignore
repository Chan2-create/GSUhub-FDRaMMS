# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase - real credentials must never be committed.
# Generated by `flutterfire configure`; firebase_options.example.dart
# documents the expected shape. flutterfire writes to lib/firebase_options.dart
# by default, so both paths are ignored.
lib/firebase_options.dart
lib/core/config/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Environment files - may carry API keys or emulator overrides.
.env
.env.*
!.env.example

# Android signing keys. A leaked keystore cannot be rotated the way an API
# key can - it is the identity the Play Store binds the app to.
*.keystore
*.jks
android/key.properties

# Editor state, personal to whoever opened the project.
.vscode/
.idea/

# Node (rules tests, Firebase CLI)
node_modules/

# Firebase Emulator Suite exported data and logs
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
storage-debug.log
